# Which environment this deployment is. MUST be one of: production | staging |
# development. It is checked against the stamp written into the database
# (app/persistence/environment.py), so a DATABASE_URL pointing at another
# environment's database fails loudly instead of silently writing to it.
AGENT_OS_APP_ENV=development

AGENT_OS_API_KEY=
# Optional multi-tenant mode. JSON maps server-held API keys to tenant ids;
# values are names only and must never be committed. The legacy API key above
# remains valid for AGENT_OS_OAUTH_TENANT_ID when both are set.
AGENT_OS_API_KEYS_JSON=
# Optional tenant-scoped provider credentials. JSON object keyed by stable
# tenant id, with provider env names as keys. Values stay in the server secret
# manager; never put this in frontend code, logs, or git.
# OAuth client registrations remain deployment-scoped; tenant-specific routing
# ids such as JIRA_CLOUD_ID and SALESFORCE_INSTANCE_URL belong in this map.
AGENT_OS_CONNECTOR_CREDENTIALS_JSON=
AGENT_OS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5000,https://agent-os-test.pages.dev,https://app.thynact.com
AGENT_OS_LLM_PROVIDER=mock
AGENT_OS_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
AGENT_OS_MAX_PARALLEL=3
AGENT_OS_MAX_RETRIES=2
AGENT_OS_MAX_JOBS=6
AGENT_OS_AUTONOMOUS_TIMEOUT_SECONDS=120

AGENT_OS_MEMORY_BACKEND=memory
AGENT_OS_WORKFLOW_BACKEND=memory
AGENT_OS_RUNTIME_BACKEND=memory
DATABASE_URL=
AGENT_OS_DB_POOL_MIN=1
AGENT_OS_DB_POOL_MAX=10
AGENT_OS_DB_COMMAND_TIMEOUT=30
AGENT_OS_QUEUE_BACKEND=memory
# Base Redis key prefix. The effective namespace is "<prefix>:<AGENT_OS_APP_ENV>",
# so production and staging cannot consume each other's jobs.
AGENT_OS_QUEUE_PREFIX=agent-os
REDIS_URL=

N8N_BASE_URL=
N8N_WEBHOOK_PREFIX=webhook
N8N_WEBHOOK_AUTH_HEADER=
N8N_WEBHOOK_AUTH_VALUE=
AGENT_OS_CIRCUIT_FAILURES=3
AGENT_OS_CIRCUIT_RECOVERY_SECONDS=30
AGENT_OS_INTEGRATION_RATE_LIMIT=60
AGENT_OS_INTEGRATION_RATE_WINDOW=60
AGENT_OS_INTEGRATION_TIMEOUT_SECONDS=30
AGENT_OS_RETRY_BACKOFF_BASE=0.25
AGENT_OS_EMBEDDING_BACKEND=deterministic
AGENT_OS_EMBEDDING_DIMENSIONS=64
AGENT_OS_SEMANTIC_WEIGHT=0.75
AGENT_OS_LEXICAL_WEIGHT=0.25

# --- OAuth / callback routing -------------------------------------------------
# Production: https://api.thynact.com and https://app.thynact.com
# Staging:    https://api-staging.thynact.com and https://staging.thynact.com
# These must never be crossed: a staging OAuth round trip pointed at the
# production callback would connect a real account through a test deployment.
AGENT_OS_OAUTH_REDIRECT_BASE_URL=
AGENT_OS_FRONTEND_URL=
AGENT_OS_OAUTH_STORAGE_BACKEND=memory
AGENT_OS_OAUTH_TENANT_ID=operator
AGENT_OS_OAUTH_ENCRYPTION_KEY=

# Verified webhook callbacks are anonymous, so multi-tenant deployments route
# them with a server-held JSON map. Keys may be provider fallbacks ("shopify")
# or provider/account keys ("shopify:store.myshopify.com"). Never expose or
# store this mapping in frontend code.
AGENT_OS_WEBHOOK_TENANT_MAP=

# OAuth client credentials. Staging must use SEPARATE provider registrations
# from production, not the same app with a different callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_MAX_SKEW_SECONDS=300
SHOPIFY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_MAX_SKEW_SECONDS=300
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# --- Additional provider credentials (names only; never commit values) --------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
RENDER_API_KEY=
RENDER_SERVICE_ID=
VERCEL_API_TOKEN=
VERCEL_DEPLOY_HOOK_URL=
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_AUTH_HEADER=
MAKE_WEBHOOK_AUTH_VALUE=
